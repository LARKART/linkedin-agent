# Copy to .env and fill in. NEVER commit .env or paste tokens into docs.
ANTHROPIC_API_KEY=
APIFY_TOKEN=

# LinkedIn (official API). Posting needs w_member_social; reading comments needs r_member_social (restricted product).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX
LINKEDIN_API_VERSION=202601

# Image generation: nvidia (FLUX) or openai
IMAGE_PROVIDER=nvidia
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Optional: Slack/Discord webhook for approval pings
NOTIFY_WEBHOOK_URL=

# Optional: Gmail email notifications. GMAIL_APP_PASSWORD is a Google App Password
# (myaccount.google.com/apppasswords, requires 2FA), NOT your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# approve = stage + notify, you run 'approve'. auto = publish after gates pass.
AGENT_MODE=approve

# Resend HTTPS email (reliable from CI). Get a key at resend.com.
RESEND_API_KEY=
RESEND_FROM=

# Video narration: free edge-tts by default. Optional voice override, e.g. en-US-GuyNeural / en-US-JennyNeural.
EDGE_TTS_VOICE=

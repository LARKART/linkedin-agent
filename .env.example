# Copy to .env and fill in. NEVER commit .env or paste tokens into docs.
ANTHROPIC_API_KEY=
APIFY_TOKEN=

# LinkedIn (official API). Posting needs w_member_social; reading comments needs r_member_social (restricted product).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX
LINKEDIN_API_VERSION=202601

# Image generation: nvidia (FLUX) or openai
IMAGE_PROVIDER=nvidia
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Optional: Slack/Discord webhook for approval pings
NOTIFY_WEBHOOK_URL=

# approve = stage + notify, you run 'approve'. auto = publish after gates pass.
AGENT_MODE=approve
